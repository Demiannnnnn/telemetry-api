# ============================================
# Telemetry API - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values

# ---- Server ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=info

# ---- Database ----
DATABASE_URL=postgres://user:password@localhost:5432/telemetry_db
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=2

# ---- Authentication ----
JWT_SECRET=your-secret-key-here
JWT_EXPIRATION_HOURS=24

# ---- Encryption ----
# Note: E2E encryption keys are managed client-side.
# The server only stores already-encrypted payloads.
ENCRYPTION_METADATA_KEY=server-metadata-key-here

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Rate Limiting ----
RATE_LIMIT_REQUESTS_PER_SECOND=100
RATE_LIMIT_BURST_SIZE=200
